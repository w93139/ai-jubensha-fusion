# AI 剧本杀融合版：复制为 .env 后修改所有 CHANGE_ME 项
# 已有.env时禁止覆盖；这是容器模板，宿主机开发见docs/development/README.md。
ENV=production
SITE_ADDRESS=:80
CORS_ORIGINS=http://localhost,https://your-domain.example

# 旧生成/编辑功能的模型配置（绝对不要使用 NEXT_PUBLIC_ 前缀）。
# 它不受下面的 Fusion 费用闸门保护，商业正文暂时不要走旧入口。
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Fusion 角色对白：默认豆包 Character；改供应商后必须新开一局。
# 只会读取被选中供应商的 Key，失败时不会自动把正文转发给另一家。
FUSION_PLAYER_PROVIDER=volcengine_ark
ARK_API_KEY=CHANGE_ME
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_CHARACTER_MODEL=doubao-seed-character-260628
DASHSCOPE_API_KEY=CHANGE_ME
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_QWEN_MODEL=qwen3.7-flash-2026-07-15

# Fusion 真实付费调用默认关闭。开启前必须同时配置人民币硬上限和所选渠道费率。
ENABLE_PAID_MODEL_CALLS=false
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1000
FUSION_PLAYER_MAX_INPUT_BYTES=20000
LLM_TEMPERATURE=0.7
# 标准局预算：正常目标不超过7元，Fusion文字模型到10元硬停止。
# 300万Token是并发预占的技术兜底；人民币硬上限才是主要费用闸门。
GAME_TOKEN_BUDGET=3000000
GAME_COST_BUDGET_CNY=10
# 2026-09-04核验的北京区 <=32K 在线推理原价（人民币/百万Token）。
# 输入字节硬限额确保当前请求留在该价格档；启用付费当天仍须复核。
ARK_CHARACTER_PRICING_VERSION=2026-09-04_CN_BEIJING_LE_32K
ARK_CHARACTER_INPUT_COST_PER_MILLION=0.8
ARK_CHARACTER_CACHED_INPUT_COST_PER_MILLION=0.16
ARK_CHARACTER_OUTPUT_COST_PER_MILLION=2
DASHSCOPE_QWEN_PRICING_VERSION=2026-09-04_CN_BEIJING_LE_32K
DASHSCOPE_QWEN_INPUT_COST_PER_MILLION=0.2
DASHSCOPE_QWEN_CACHED_INPUT_COST_PER_MILLION=0.04
DASHSCOPE_QWEN_OUTPUT_COST_PER_MILLION=0.8

# 登录与安全
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
ALLOW_ANONYMOUS_ACCESS=false
ALLOW_LEGACY_REGISTRATION=false
INVITE_CODES=CHANGE_ME_INVITE_CODE
SMS_PROVIDER=mock
# 仅限本地测试；生产环境接入短信供应商后删除
SMS_MOCK_CODE=123456

# PostgreSQL / Redis
DB_HOST=db
DB_PORT=5432
DB_NAME=jubensha
DB_USER=jubensha
DB_PASSWORD=CHANGE_ME
DB_POOL_SIZE=10
REDIS_URL=redis://redis:6379/0

# 容器端口与同源反向代理
HOST=0.0.0.0
PORT=8010
NEXT_PUBLIC_API_URL=/

# 首版关闭媒体生成能力；管理员仍可上传封面
ENABLE_MEDIA_FEATURES=false
FILE_STORAGE=dir

# 来源快照：默认位于仓库外 ../private-data/import-jobs/source-bundles
# 需要覆盖时填写仓库外的私有绝对路径；不放在 public/static 或 Git 内。
# FUSION_SOURCE_BUNDLE_DIR=/absolute/private/source-bundles

# 玩家语音输入：独立豆包 ASR 凭据，不使用 ARK 文字密钥。默认关闭。
ENABLE_DOUBAO_ASR=false
# 语音供应商显式选择；千问识别独立于角色回答模型，不自动回退。
SPEECH_INPUT_PROVIDER=doubao
ENABLE_QWEN_ASR=false
# 边说边转写；启用后仍需玩家校对并主动发送。
ENABLE_QWEN_REALTIME_ASR=false
# 千问默认复用服务器 DASHSCOPE_API_KEY（北京），也可单独配置下列Key。
# 固定识别模型：qwen-audio-3.0-asr-flash；不要填角色文本模型。
QWEN_ASR_API_KEY=
# 两家共用原时长账本；未设置这些项时沿用下方 DOUBAO_ASR_* 限额。
# SPEECH_INPUT_STATE_DIR=/absolute/private/speech-input
# SPEECH_INPUT_DAILY_SECONDS=3600
# SPEECH_INPUT_PLAY_SECONDS=1800
# SPEECH_INPUT_TIMEOUT_SECONDS=45
# 新版豆包语音控制台 API Key；或使用完整的旧版 App ID + Access Token。
DOUBAO_ASR_API_KEY=
DOUBAO_ASR_APP_ID=
DOUBAO_ASR_ACCESS_TOKEN=
# 默认仓库外 ../private-data/speech-input；目录必须私有且无符号链接。
# DOUBAO_ASR_STATE_DIR=/absolute/private/speech-input
# 按实际 PCM 帧数累计，日界线为北京时间；失败/未知也保留预占时长。
DOUBAO_ASR_DAILY_SECONDS=3600
DOUBAO_ASR_PLAY_SECONDS=1800
DOUBAO_ASR_TIMEOUT_SECONDS=45
