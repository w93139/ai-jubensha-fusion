# AI 剧本杀融合版：复制为 .env 后修改所有 CHANGE_ME 项
ENV=production
SITE_ADDRESS=:80
CORS_ORIGINS=http://localhost,https://your-domain.example

# 服务端模型密钥（绝对不要使用 NEXT_PUBLIC_ 前缀）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1000
GAME_TOKEN_BUDGET=30000
# 按 DeepSeek 当前账单填写，用于成本估算（每百万 Token）
DEEPSEEK_INPUT_COST_PER_MILLION=0
DEEPSEEK_OUTPUT_COST_PER_MILLION=0

# 登录与安全
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
ALLOW_ANONYMOUS_ACCESS=false
ALLOW_LEGACY_REGISTRATION=false
INVITE_CODES=CHANGE_ME_INVITE_CODE
SMS_PROVIDER=mock
# 仅限本地测试；生产环境接入短信供应商后删除
SMS_MOCK_CODE=123456

# PostgreSQL / Redis
DB_HOST=db
DB_PORT=5432
DB_NAME=jubensha
DB_USER=jubensha
DB_PASSWORD=CHANGE_ME
DB_POOL_SIZE=10
REDIS_URL=redis://redis:6379/0

# 容器端口与同源反向代理
HOST=0.0.0.0
PORT=8010
NEXT_PUBLIC_API_URL=/

# 首版关闭媒体生成能力；管理员仍可上传封面
ENABLE_MEDIA_FEATURES=false
FILE_STORAGE=dir
