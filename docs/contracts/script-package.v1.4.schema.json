{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AccusationIdentity": {
      "additionalProperties": false,
      "properties": {
        "available_when": {
          "items": {
            "items": {
              "$ref": "#/$defs/FinaleMaterialRef"
            },
            "type": "array"
          },
          "maxItems": 100,
          "title": "Available When",
          "type": "array"
        },
        "heard_terms": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Heard Terms",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        },
        "group_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Group Id",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "group_id",
        "sources"
      ],
      "title": "AccusationIdentity",
      "type": "object"
    },
    "AnswerAtom": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ANSWER_MATCH",
          "title": "Kind",
          "type": "string"
        },
        "question_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Question Id",
          "type": "string"
        },
        "option_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
            "type": "string"
          },
          "maxItems": 10,
          "title": "Option Ids",
          "type": "array"
        },
        "mode": {
          "enum": [
            "EXACT",
            "CONTAINS"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "question_id",
        "option_ids",
        "mode"
      ],
      "title": "AnswerAtom",
      "type": "object"
    },
    "CountAtom": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "GROUP_VOTES",
            "IDENTITY_VOTES",
            "EXTERNAL_GROUP_VOTES",
            "TRUST_COUNT"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Target Id",
          "type": "string"
        },
        "excluded_actor": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excluded Actor"
        },
        "op": {
          "enum": [
            "EQ",
            "GE",
            "GT"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "maximum": 5,
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "target_id",
        "op",
        "value"
      ],
      "title": "CountAtom",
      "type": "object"
    },
    "EvidenceMemoryTrigger": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ACQUIRED_EVIDENCE",
          "title": "Kind",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Evidence Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "evidence_id"
      ],
      "title": "EvidenceMemoryTrigger",
      "type": "object"
    },
    "FactTerm": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Fact Id",
          "type": "string"
        },
        "expected": {
          "title": "Expected",
          "type": "boolean"
        }
      },
      "required": [
        "fact_id",
        "expected"
      ],
      "title": "FactTerm",
      "type": "object"
    },
    "FinaleEnding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "when": {
          "items": {
            "items": {
              "$ref": "#/$defs/FactTerm"
            },
            "maxItems": 50,
            "type": "array"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "When",
          "type": "array"
        },
        "truth_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Truth Ids",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "when",
        "truth_ids",
        "sources"
      ],
      "title": "FinaleEnding",
      "type": "object"
    },
    "FinaleEndingGroup": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "character_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Character Ids",
          "type": "array"
        },
        "branches": {
          "items": {
            "$ref": "#/$defs/FinaleEnding"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Branches",
          "type": "array"
        }
      },
      "required": [
        "id",
        "character_ids",
        "branches"
      ],
      "title": "FinaleEndingGroup",
      "type": "object"
    },
    "FinaleFact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "when": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "discriminator": {
                    "mapping": {
                      "ALL_MEMORIES": "#/$defs/MemoryAtom",
                      "ANSWER_MATCH": "#/$defs/AnswerAtom",
                      "ANSWER_SUPPORT": "#/$defs/SupportAtom",
                      "EXTERNAL_GROUP_VOTES": "#/$defs/CountAtom",
                      "GROUP_VOTES": "#/$defs/CountAtom",
                      "IDENTITY_MORE": "#/$defs/MoreAtom",
                      "IDENTITY_VOTES": "#/$defs/CountAtom",
                      "TRUST_COUNT": "#/$defs/CountAtom",
                      "TRUST_MORE": "#/$defs/MoreAtom",
                      "TRUST_TO": "#/$defs/TrustAtom"
                    },
                    "propertyName": "kind"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/$defs/AnswerAtom"
                    },
                    {
                      "$ref": "#/$defs/SupportAtom"
                    },
                    {
                      "$ref": "#/$defs/CountAtom"
                    },
                    {
                      "$ref": "#/$defs/MoreAtom"
                    },
                    {
                      "$ref": "#/$defs/TrustAtom"
                    },
                    {
                      "$ref": "#/$defs/MemoryAtom"
                    }
                  ]
                },
                "maxItems": 50,
                "type": "array"
              },
              "maxItems": 50,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "When"
        },
        "origin": {
          "enum": [
            "SOURCE_EXPLICIT",
            "EDITORIAL"
          ],
          "title": "Origin",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "when",
        "origin",
        "sources"
      ],
      "title": "FinaleFact",
      "type": "object"
    },
    "FinaleGoal": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "character_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Character Id",
          "type": "string"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/FinaleScorePart"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Parts",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "character_id",
        "title",
        "parts",
        "sources"
      ],
      "title": "FinaleGoal",
      "type": "object"
    },
    "FinaleMaterialRef": {
      "additionalProperties": false,
      "properties": {
        "collection": {
          "enum": [
            "knowledge",
            "evidence",
            "memory"
          ],
          "title": "Collection",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "collection",
        "id"
      ],
      "title": "FinaleMaterialRef",
      "type": "object"
    },
    "FinaleOption": {
      "additionalProperties": false,
      "properties": {
        "available_when": {
          "items": {
            "items": {
              "$ref": "#/$defs/FinaleMaterialRef"
            },
            "type": "array"
          },
          "maxItems": 100,
          "title": "Available When",
          "type": "array"
        },
        "heard_terms": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Heard Terms",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "FinaleOption",
      "type": "object"
    },
    "FinaleScorePart": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "points": {
          "maximum": 100,
          "minimum": 1,
          "title": "Points",
          "type": "integer"
        },
        "explanation": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation"
        },
        "when": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "$ref": "#/$defs/FactTerm"
                },
                "maxItems": 50,
                "type": "array"
              },
              "maxItems": 50,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "When"
        },
        "ending_ids": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
                "type": "string"
              },
              "maxItems": 30,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ending Ids"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "points",
        "when",
        "sources"
      ],
      "title": "FinaleScorePart",
      "type": "object"
    },
    "FinaleVotePlan": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "finale-vote-plan/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "character_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Character Ids",
          "type": "array"
        },
        "identities": {
          "items": {
            "$ref": "#/$defs/AccusationIdentity"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Identities",
          "type": "array"
        },
        "majority_threshold": {
          "const": 3,
          "title": "Majority Threshold",
          "type": "integer"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "character_ids",
        "identities",
        "majority_threshold",
        "sources"
      ],
      "title": "FinaleVotePlan",
      "type": "object"
    },
    "FullPlayActionOrder": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Action Id",
          "type": "string"
        },
        "order": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        }
      },
      "required": [
        "action_id",
        "order"
      ],
      "title": "FullPlayActionOrder",
      "type": "object"
    },
    "FullPlayMechanics": {
      "additionalProperties": false,
      "properties": {
        "phases": {
          "items": {
            "$ref": "#/$defs/FullPlayPhase"
          },
          "maxItems": 100,
          "minItems": 3,
          "title": "Phases",
          "type": "array"
        },
        "action_order": {
          "items": {
            "$ref": "#/$defs/FullPlayActionOrder"
          },
          "maxItems": 5000,
          "minItems": 1,
          "title": "Action Order",
          "type": "array"
        },
        "finale": {
          "$ref": "#/$defs/StructuredFinalePlan"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "phases",
        "action_order",
        "finale",
        "sources"
      ],
      "title": "FullPlayMechanics",
      "type": "object"
    },
    "FullPlayPhase": {
      "additionalProperties": false,
      "properties": {
        "phase_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Phase Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "READING",
            "INVESTIGATION",
            "FINALE"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "phase_id",
        "kind",
        "sources"
      ],
      "title": "FullPlayPhase",
      "type": "object"
    },
    "HeardMemoryTrigger": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "OTHER_HEARD_SPEECH",
          "title": "Kind",
          "type": "string"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Keywords",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "keywords"
      ],
      "title": "HeardMemoryTrigger",
      "type": "object"
    },
    "InvestigationAction": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        },
        "cost": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Cost",
          "type": "integer"
        },
        "phase_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Phase Ids",
          "type": "array"
        },
        "allowed_character_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Allowed Character Ids",
          "type": "array"
        },
        "required_action_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Required Action Ids",
          "type": "array"
        },
        "required_public_evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Required Public Evidence Ids",
          "type": "array"
        },
        "origin": {
          "enum": [
            "SOURCE_EXPLICIT",
            "EDITORIAL"
          ],
          "title": "Origin",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "cost",
        "phase_ids",
        "allowed_character_ids",
        "origin",
        "sources"
      ],
      "title": "InvestigationAction",
      "type": "object"
    },
    "InvestigationMechanics": {
      "additionalProperties": false,
      "properties": {
        "phase_budgets": {
          "items": {
            "$ref": "#/$defs/PhaseActionBudget"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Phase Budgets",
          "type": "array"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/InvestigationAction"
          },
          "maxItems": 5000,
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        }
      },
      "required": [
        "phase_budgets",
        "actions"
      ],
      "title": "InvestigationMechanics",
      "type": "object"
    },
    "KnowledgeItemV14": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 40000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "enum": [
            "FACT",
            "CLAIM",
            "INFERENCE"
          ],
          "title": "Kind",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "PUBLIC",
            "CHARACTER_PRIVATE"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "character_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Character Id"
        },
        "release": {
          "$ref": "#/$defs/ReleaseRuleV12"
        },
        "disclosure": {
          "enum": [
            "PUBLIC",
            "MAY_SHARE",
            "MUST_SHARE",
            "KEEP_PRIVATE"
          ],
          "title": "Disclosure",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "retelling": {
          "anyOf": [
            {
              "enum": [
                "MAY_RETELL",
                "MUST_RETELL"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retelling"
        }
      },
      "required": [
        "id",
        "text",
        "kind",
        "visibility",
        "character_id",
        "release",
        "disclosure",
        "sources"
      ],
      "title": "KnowledgeItemV14",
      "type": "object"
    },
    "MemoryAtom": {
