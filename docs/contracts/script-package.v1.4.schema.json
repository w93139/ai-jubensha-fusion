    "SourceFileV11": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "original_source_ids": {
                "maxItems": 0
              }
            }
          },
          "if": {
            "properties": {
              "kind": {
                "const": "normalized"
              }
            }
          },
          "then": {
            "properties": {
              "original_source_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "else": {
            "not": {
              "required": [
                "provenance_note"
              ]
            }
          },
          "if": {
            "properties": {
              "kind": {
                "const": "supplement"
              }
            }
          },
          "then": {
            "properties": {
              "provenance_note": {
                "type": "string"
              }
            },
            "required": [
              "provenance_note"
            ]
          }
        }
      ],
      "description": "Explicit editorial provenance; source declarations never approve content.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "original",
            "normalized",
            "supplement"
          ],
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "application/pdf",
            "text/plain",
            "text/markdown",
            "image/png",
            "image/jpeg"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "original_source_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
            "type": "string"
          },
          "maxItems": 200,
          "title": "Original Source Ids",
          "type": "array",
          "uniqueItems": true
        },
        "provenance_note": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance Note"
        },
        "page_count": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Count"
        }
      },
      "required": [
        "id",
        "relative_path",
        "sha256",
        "kind",
        "media_type",
        "original_source_ids"
      ],
      "title": "SourceFileV11",
      "type": "object"
    },
