{
  "additionalProperties": false,
  "properties": {
    "expected_revision": {
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "idempotency_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "character_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
      "title": "Character Id",
      "type": "string"
    },
    "question": {
      "description": "One non-blank question, at most 1000 input characters; surrounding whitespace is trimmed before hashing.",
      "maxLength": 1000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Question",
      "type": "string"
    }
  },
  "required": [
    "expected_revision",
    "idempotency_key",
    "character_id",
    "question"
  ],
  "title": "PackagePlayAskRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
