{
  "$defs": {
    "CompileBlocker": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "SOURCE_GAP",
            "UNSUPPORTED_MECHANIC",
            "CONTRADICTION"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "code",
        "message",
        "sources"
      ],
      "title": "CompileBlocker",
      "type": "object"
    },
    "CompilerContent": {
      "additionalProperties": false,
      "description": "Model-authored content only; frozen package metadata is server-owned.",
      "properties": {
        "introduction": {
          "$ref": "#/$defs/SourcedText"
        },
        "characters": {
          "items": {
            "$ref": "#/$defs/PackageCharacter"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Characters",
          "type": "array"
        },
        "initial_phase_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Initial Phase Id",
          "type": "string"
        },
        "phases": {
          "items": {
            "$ref": "#/$defs/PackagePhase"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Phases",
          "type": "array"
        },
        "knowledge": {
          "items": {
            "$ref": "#/$defs/KnowledgeItem"
          },
          "maxItems": 5000,
          "minItems": 1,
          "title": "Knowledge",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/PackageEvidence"
          },
          "maxItems": 5000,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "truth": {
          "items": {
            "$ref": "#/$defs/TruthItem"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Truth",
          "type": "array"
        },
        "settlement": {
          "$ref": "#/$defs/Settlement"
        }
      },
      "required": [
        "introduction",
        "characters",
        "initial_phase_id",
        "phases",
        "knowledge",
        "evidence",
        "truth",
        "settlement"
      ],
      "title": "CompilerContent",
      "type": "object"
    },
    "KnowledgeItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 40000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "enum": [
            "FACT",
            "CLAIM",
            "INFERENCE"
          ],
          "title": "Kind",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "PUBLIC",
            "CHARACTER_PRIVATE"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "character_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Character Id"
        },
        "release": {
          "$ref": "#/$defs/ReleaseRule"
        },
        "disclosure": {
          "enum": [
            "PUBLIC",
            "MAY_SHARE",
            "MUST_SHARE",
            "KEEP_PRIVATE"
          ],
          "title": "Disclosure",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "kind",
        "visibility",
        "character_id",
        "release",
        "disclosure",
        "sources"
      ],
      "title": "KnowledgeItem",
      "type": "object"
    },
    "PackageCharacter": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "sources"
      ],
      "title": "PackageCharacter",
      "type": "object"
    },
    "PackageEvidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 40000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "PUBLIC",
            "CHARACTER_PRIVATE"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "character_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Character Id"
        },
        "release": {
          "$ref": "#/$defs/ReleaseRule"
        },
        "disclosure": {
          "enum": [
            "PUBLIC",
            "MAY_SHARE",
            "MUST_SHARE",
            "KEEP_PRIVATE"
          ],
          "title": "Disclosure",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "visibility",
        "character_id",
        "release",
        "disclosure",
        "sources"
      ],
      "title": "PackageEvidence",
      "type": "object"
    },
    "PackagePhase": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "next_phase_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Phase Id"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "next_phase_id",
        "sources"
      ],
      "title": "PackagePhase",
      "type": "object"
    },
    "ReleaseRule": {
      "additionalProperties": false,
      "description": "A phase floor plus AND prerequisites; no executable expressions.",
      "properties": {
        "phase_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Phase Id",
          "type": "string"
        },
        "required_public_evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Required Public Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "phase_id"
      ],
      "title": "ReleaseRule",
      "type": "object"
    },
    "Settlement": {
      "additionalProperties": false,
      "properties": {
        "phase_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Phase Id",
          "type": "string"
        },
        "truth_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Truth Ids",
          "type": "array"
        },
        "instructions": {
          "$ref": "#/$defs/SourcedText"
        }
      },
      "required": [
        "phase_id",
        "truth_ids",
        "instructions"
      ],
      "title": "Settlement",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Source Id",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "anchor": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor"
        }
      },
      "required": [
        "source_id"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "SourcedText": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 40000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "text",
        "sources"
      ],
      "title": "SourcedText",
      "type": "object"
    },
    "TruthItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 40000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "visibility": {
          "const": "SYSTEM_TRUTH",
          "title": "Visibility",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "visibility",
        "sources"
      ],
      "title": "TruthItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Strict wire response; never accepts a complete package from the model.",
  "properties": {
    "schema_version": {
      "const": "compiler-draft/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "BLOCKED"
      ],
      "title": "Status",
      "type": "string"
    },
    "content": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompilerContent"
        },
        {
          "type": "null"
        }
      ]
    },
    "blockers": {
      "items": {
        "$ref": "#/$defs/CompileBlocker"
      },
      "maxItems": 100,
      "title": "Blockers",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "status",
    "content",
    "blockers"
  ],
  "title": "CompilerDraftOutput",
  "type": "object"
}
