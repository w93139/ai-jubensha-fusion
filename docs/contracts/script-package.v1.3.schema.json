{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EvidenceMemoryTrigger": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "ACQUIRED_EVIDENCE",
          "title": "Kind",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Evidence Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "evidence_id"
      ],
      "title": "EvidenceMemoryTrigger",
      "type": "object"
    },
    "InvestigationAction": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        },
        "cost": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Cost",
          "type": "integer"
        },
        "phase_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Phase Ids",
          "type": "array"
        },
        "allowed_character_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Allowed Character Ids",
          "type": "array"
        },
        "required_action_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Required Action Ids",
          "type": "array"
        },
        "required_public_evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Required Public Evidence Ids",
          "type": "array"
        },
        "origin": {
          "enum": [
            "SOURCE_EXPLICIT",
            "EDITORIAL"
          ],
          "title": "Origin",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "cost",
        "phase_ids",
        "allowed_character_ids",
        "origin",
        "sources"
      ],
      "title": "InvestigationAction",
      "type": "object"
    },
    "InvestigationMechanics": {
      "additionalProperties": false,
      "properties": {
        "phase_budgets": {
          "items": {
            "$ref": "#/$defs/PhaseActionBudget"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Phase Budgets",
          "type": "array"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/InvestigationAction"
          },
          "maxItems": 5000,
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        }
      },
      "required": [
        "phase_budgets",
        "actions"
      ],
      "title": "InvestigationMechanics",
      "type": "object"
    },
    "KnowledgeItemV12": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 40000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "enum": [
            "FACT",
            "CLAIM",
            "INFERENCE"
          ],
          "title": "Kind",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "PUBLIC",
            "CHARACTER_PRIVATE"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "character_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Character Id"
        },
        "release": {
          "$ref": "#/$defs/ReleaseRuleV12"
        },
        "disclosure": {
          "enum": [
            "PUBLIC",
            "MAY_SHARE",
            "MUST_SHARE",
            "KEEP_PRIVATE"
          ],
          "title": "Disclosure",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "kind",
        "visibility",
        "character_id",
        "release",
        "disclosure",
        "sources"
      ],
      "title": "KnowledgeItemV12",
      "type": "object"
    },
    "PackageCharacter": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "sources"
      ],
      "title": "PackageCharacter",
      "type": "object"
    },
    "PackageEvidenceV12": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 40000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "PUBLIC",
            "CHARACTER_PRIVATE"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "character_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Character Id"
        },
        "release": {
          "$ref": "#/$defs/ReleaseRuleV12"
        },
        "disclosure": {
          "enum": [
            "PUBLIC",
            "MAY_SHARE",
            "MUST_SHARE",
            "KEEP_PRIVATE"
          ],
          "title": "Disclosure",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "visibility",
        "character_id",
        "release",
        "disclosure",
        "sources"
      ],
      "title": "PackageEvidenceV12",
      "type": "object"
    },
    "PackagePhase": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "next_phase_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Phase Id"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "next_phase_id",
        "sources"
      ],
      "title": "PackagePhase",
      "type": "object"
    },
    "PhaseActionBudget": {
      "additionalProperties": false,
      "properties": {
        "phase_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Phase Id",
          "type": "string"
        },
        "points": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Points",
          "type": "integer"
        },
        "advance_policy": {
          "enum": [
            "ALLOW_REMAINING",
            "REQUIRE_EXHAUSTED"
          ],
          "title": "Advance Policy",
          "type": "string"
        },
        "origin": {
          "enum": [
            "SOURCE_EXPLICIT",
            "EDITORIAL"
          ],
          "title": "Origin",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "phase_id",
        "points",
        "advance_policy",
        "origin",
        "sources"
      ],
      "title": "PhaseActionBudget",
      "type": "object"
    },
    "PrivateMemory": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "character_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Character Id",
          "type": "string"
        },
        "phase_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Phase Id",
          "type": "string"
        },
        "title": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "text": {
          "maxLength": 40000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "enum": [
            "FACT",
            "CLAIM",
            "INFERENCE"
          ],
          "title": "Kind",
          "type": "string"
        },
        "card_disclosure": {
          "const": "KEEP_PRIVATE",
          "title": "Card Disclosure",
          "type": "string"
        },
        "retelling": {
          "enum": [
            "MAY_RETELL",
            "MUST_RETELL"
          ],
          "title": "Retelling",
          "type": "string"
        },
        "triggers": {
          "items": {
            "discriminator": {
              "mapping": {
                "ACQUIRED_EVIDENCE": "#/$defs/EvidenceMemoryTrigger",
                "OTHER_PUBLIC_SPEECH": "#/$defs/SpeechMemoryTrigger"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/SpeechMemoryTrigger"
              },
              {
                "$ref": "#/$defs/EvidenceMemoryTrigger"
              }
            ]
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Triggers",
          "type": "array"
        },
        "origin": {
          "enum": [
            "SOURCE_EXPLICIT",
            "EDITORIAL"
          ],
          "title": "Origin",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "character_id",
        "phase_id",
        "title",
        "text",
        "kind",
        "card_disclosure",
        "retelling",
        "triggers",
        "origin",
        "sources"
      ],
      "title": "PrivateMemory",
      "type": "object"
    },
    "ReleaseRuleV12": {
      "additionalProperties": false,
      "properties": {
        "phase_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Phase Id",
          "type": "string"
        },
        "required_public_evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Required Public Evidence Ids",
          "type": "array"
        },
        "required_action_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Required Action Ids",
          "type": "array"
        }
      },
      "required": [
        "phase_id"
      ],
      "title": "ReleaseRuleV12",
      "type": "object"
    },
    "Settlement": {
      "additionalProperties": false,
      "properties": {
        "phase_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Phase Id",
          "type": "string"
        },
        "truth_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Truth Ids",
          "type": "array"
        },
        "instructions": {
          "$ref": "#/$defs/SourcedText"
        }
      },
      "required": [
        "phase_id",
        "truth_ids",
        "instructions"
      ],
      "title": "Settlement",
      "type": "object"
    },
    "SourceFileV11": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "original_source_ids": {
                "maxItems": 0
              }
            }
          },
          "if": {
            "properties": {
              "kind": {
                "const": "normalized"
              }
            }
          },
          "then": {
            "properties": {
              "original_source_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "else": {
            "not": {
              "required": [
                "provenance_note"
              ]
            }
          },
          "if": {
            "properties": {
              "kind": {
                "const": "supplement"
              }
            }
          },
          "then": {
            "properties": {
              "provenance_note": {
                "type": "string"
              }
            },
            "required": [
              "provenance_note"
            ]
          }
        }
      ],
      "description": "Explicit editorial provenance; source declarations never approve content.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "original",
            "normalized",
            "supplement"
          ],
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "application/pdf",
            "text/plain",
            "text/markdown",
            "image/png",
            "image/jpeg"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "original_source_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
            "type": "string"
          },
          "maxItems": 200,
          "title": "Original Source Ids",
          "type": "array",
          "uniqueItems": true
        },
        "provenance_note": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance Note"
        },
        "page_count": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Count"
        }
      },
      "required": [
        "id",
        "relative_path",
        "sha256",
        "kind",
        "media_type",
        "original_source_ids"
      ],
      "title": "SourceFileV11",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Source Id",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "anchor": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor"
        }
      },
      "required": [
        "source_id"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "SourcedText": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 40000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "text",
        "sources"
      ],
      "title": "SourcedText",
      "type": "object"
    },
    "SpeechMemoryTrigger": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "OTHER_PUBLIC_SPEECH",
          "title": "Kind",
          "type": "string"
        },
        "keyword": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Keyword",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "keyword"
      ],
      "title": "SpeechMemoryTrigger",
      "type": "object"
    },
    "TruthItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 40000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "visibility": {
          "const": "SYSTEM_TRUTH",
          "title": "Visibility",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "visibility",
        "sources"
      ],
      "title": "TruthItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "script-package/1.3",
      "title": "Schema Version",
      "type": "string"
    },
    "script_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
      "title": "Script Key",
      "type": "string"
    },
    "content_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
      "title": "Content Version",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Title",
      "type": "string"
    },
    "player_count": {
      "maximum": 8,
      "minimum": 2,
      "title": "Player Count",
      "type": "integer"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceFileV11"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "introduction": {
      "$ref": "#/$defs/SourcedText"
    },
    "characters": {
      "items": {
        "$ref": "#/$defs/PackageCharacter"
      },
      "maxItems": 8,
      "minItems": 2,
      "title": "Characters",
      "type": "array"
    },
    "initial_phase_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$",
      "title": "Initial Phase Id",
      "type": "string"
    },
    "phases": {
      "items": {
        "$ref": "#/$defs/PackagePhase"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Phases",
      "type": "array"
    },
    "knowledge": {
      "items": {
        "$ref": "#/$defs/KnowledgeItemV12"
      },
      "maxItems": 5000,
      "minItems": 1,
      "title": "Knowledge",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/PackageEvidenceV12"
      },
      "maxItems": 5000,
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "truth": {
      "items": {
        "$ref": "#/$defs/TruthItem"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Truth",
      "type": "array"
    },
    "settlement": {
      "$ref": "#/$defs/Settlement"
    },
    "mechanics": {
      "$ref": "#/$defs/InvestigationMechanics"
    },
    "memories": {
      "items": {
        "$ref": "#/$defs/PrivateMemory"
      },
      "maxItems": 1000,
